def unit_converter():
    # 1. Define conversion factors relative to a base unit
    # Distance base: Meters | Weight base: Kilograms
    conversions = {
        "distance": {
            "meters": 1.0,
            "kilometers": 1000.0,
            "miles": 1609.34,
            "feet": 0.3048
        },
        "weight": {
            "kilograms": 1.0,
            "grams": 0.001,
            "pounds": 0.453592,
            "ounces": 0.0283495
        }
    }

    print("--- Smart Unit Converter ---")
    print("Available categories: Distance, Weight")
    
    # 2. Get User Input
    category = input("Choose a category: ").lower()
    
    if category not in conversions:
        print("Sorry, that category isn't supported yet!")
        return

    print(f"Supported units: {', '.join(conversions[category].keys())}")
    
    value = float(input("Enter the value: "))
    from_unit = input("Convert from: ").lower()
    to_unit = input("Convert to: ").lower()

    # 3. Perform the Math
    if from_unit in conversions[category] and to_unit in conversions[category]:
        # Logic: Convert input to base unit, then convert base unit to target
        # Formula: (Value * From_Factor) / To_Factor
        base_value = value * conversions[category][from_unit]
        result = base_value / conversions[category][to_unit]

        print(f"\nResult: {value} {from_unit} = {round(result, 4)} {to_unit}")
    else:
        print("Invalid units entered.")

# Run the program
if __name__ == "__main__":
    unit_converter()
