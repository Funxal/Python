import tkinter as tk
from tkinter import messagebox

class CuteCalculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Python Calculator")
        self.root.geometry("350x500")
        self.root.configure(bg="#f0f0f3")  # Soft background color

        self.equation = ""
        
        # Display Screen
        self.display = tk.Entry(
            root, font=("Poppins", 24), borderwidth=0, 
            relief="flat", justify="right", bg="#f0f0f3", fg="#444"
        )
        self.display.grid(row=0, column=0, columnspan=4, padx=20, pady=40, sticky="nsew")
        self.display.insert(0, "0")

        # Button configuration (Label, Row, Column, Color)
        buttons = [
            ('clr', 1, 0), ('DEL', 1, 1), ('%', 1, 2), ('/', 1, 3),
            ('7', 2, 0), ('8', 2, 1), ('9', 2, 2), ('*', 2, 3),
            ('4', 3, 0), ('5', 3, 1), ('6', 3, 2), ('-', 3, 3),
            ('1', 4, 0), ('2', 4, 1), ('3', 4, 2), ('+', 4, 3),
            ('.', 5, 0), ('0', 5, 1), ('=', 5, 2)
        ]

        for (text, row, col) in buttons:
            self.create_button(text, row, col)

    def create_button(self, text, row, col):
        # Specific styling for the "=" button
        bg_color = "#e6b3cc" if text == "=" else "#ffffff"
        width = 10 if text == "=" else 5
        columnspan = 2 if text == "=" else 1

        button = tk.Button(
            self.root, text=text, width=width, height=2,
            font=("Poppins", 12, "bold"), bg=bg_color, fg="#555",
            relief="flat", activebackground="#d9a0be",
            command=lambda: self.on_click(text)
        )
        button.grid(row=row, column=col, columnspan=columnspan, padx=8, pady=8, sticky="nsew")

    def on_click(self, char):
        if char == "clr":
            self.equation = ""
        elif char == "DEL":
            self.equation = self.equation[:-1]
        elif char == "=":
            try:
                self.equation = str(eval(self.equation))
            except:
                messagebox.showerror("Error", "Invalid Input")
                self.equation = ""
        else:
            self.equation += str(char)
        
        self.update_display()

    def update_display(self):
        self.display.delete(0, tk.END)
        self.display.insert(0, self.equation if self.equation else "0")

if __name__ == "__main__":
    root = tk.Tk()
    app = CuteCalculator(root)
    root.mainloop()
