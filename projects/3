def solve(board):
    """
    Uses recursion to solve the board.
    Returns True if solved, False if no solution exists.
    """
    find = find_empty(board)
    if not find:
        return True  # Board is full
    else:
        row, col = find

    for i in range(1, 10): # Try numbers 1-9
        if is_valid(board, i, (row, col)):
            board[row][col] = i

            if solve(board): # Recursively try to solve the rest
                return True

            board[row][col] = 0 # Backtrack: Reset if the choice didn't work

    return False

# Add this to your main play_game loop or run it separately
def show_solution(board):
    print("\nSolving...\n")
    if solve(board):
        print_board(board)
    else:
        print("No solution exists for this board.")
